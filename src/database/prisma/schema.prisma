generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoCuidado {
  edad_avanzada
  discapacidad
  enfermedad_cronica
  recuperacion
  menor_necesidades_especiales
  otro
}

enum Severidad {
  leve
  moderada
  grave
}

enum RolMiembro {
  titular
  administrador
  cocuidador
  solo_lectura
  temporal
  profesional
}

enum EstadoMiembro {
  invitado
  activo
  revocado
  vencido
}

model PersonaCuidada {
  id               String        @id @default(uuid()) @db.Char(36)
  titularUsuarioId String?       @map("titular_usuario_id") @db.Char(36)
  nombre           String        @db.VarChar(120)
  fechaNacimiento  DateTime      @map("fecha_nacimiento") @db.Date
  telefono         String?       @db.VarChar(20)
  tipoCuidado      TipoCuidado   @map("tipo_cuidado")
  fotoUrl          String?       @map("foto_url") @db.VarChar(500)
  creadoPor        String?       @map("creado_por") @db.Char(36)
  creadoEn         DateTime      @default(now()) @map("creado_en") @db.DateTime(3)
  miembros         MiembroRed[]
  ficha            FichaMedica?
  alergias         Alergia[]
  padecimientos    Padecimiento[]
  medicamentos     Medicamento[]
  recordatorios    Recordatorio[]
  consentimientos  Consentimiento[]
  bitacora         BitacoraAcceso[]

  @@map("persona_cuidada")
}

model MiembroRed {
  id          String          @id @default(uuid()) @db.Char(36)
  personaId   String          @map("persona_id") @db.Char(36)
  usuarioId   String          @map("usuario_id") @db.Char(36)
  rol         RolMiembro
  relacion    String?         @db.VarChar(40)
  estado      EstadoMiembro   @default(invitado)
  venceEn     DateTime?       @map("vence_en") @db.DateTime(3)
  invitadoPor String?         @map("invitado_por") @db.Char(36)
  persona     PersonaCuidada  @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, usuarioId])
  @@map("miembro_red")
}

enum RolPreferido {
  cuidador
  recibe_cuidados
}

enum Plataforma {
  ios
  android
  web
}

model Usuario {
  id                String              @id @default(uuid()) @db.Char(36)
  telefono          String              @unique @db.VarChar(20)
  nombre            String              @default("") @db.VarChar(120)
  fotoUrl           String?             @map("foto_url") @db.VarChar(500)
  rolPreferido      RolPreferido        @default(cuidador) @map("rol_preferido")
  preferenciasNotif Json?               @map("preferencias_notif")
  modoLecturaFacil  Boolean             @default(false) @map("modo_lectura_facil")
  creadoEn          DateTime            @default(now()) @map("creado_en") @db.DateTime(3)
  eliminadoEn       DateTime?           @map("eliminado_en") @db.DateTime(3)
  sesiones          SesionDispositivo[]

  @@map("usuario")
}

model VerificacionOtp {
  id           String    @id @default(uuid()) @db.Char(36)
  telefono     String    @db.VarChar(20)
  codigoHash   String    @map("codigo_hash") @db.Char(64)
  intentos     Int       @default(0) @db.SmallInt
  reenvios     Int       @default(0) @db.SmallInt
  expiraEn     DateTime  @map("expira_en") @db.DateTime(3)
  verificadoEn DateTime? @map("verificado_en") @db.DateTime(3)

  @@map("verificacion_otp")
}

model SesionDispositivo {
  id                String    @id @default(uuid()) @db.Char(36)
  usuarioId         String    @map("usuario_id") @db.Char(36)
  nombreDispositivo String?   @map("nombre_dispositivo") @db.VarChar(80)
  plataforma        Plataforma
  pushToken         String?   @map("push_token") @db.Text
  refreshTokenHash  String    @map("refresh_token_hash") @db.Char(64)
  ultimoAcceso      DateTime? @map("ultimo_acceso") @db.DateTime(3)
  revocadaEn        DateTime? @map("revocada_en") @db.DateTime(3)
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sesion_dispositivo")
}

model FichaMedica {
  personaId        String          @id @map("persona_id") @db.Char(36)
  tipoSanguineo    String?         @map("tipo_sanguineo") @db.VarChar(3)
  medicoTratante   String?         @map("medico_tratante") @db.VarChar(120)
  institucionSalud String?         @map("institucion_salud") @db.VarChar(120)
  antecedentes     Bytes?          @db.VarBinary(4096)
  observaciones    String?         @db.VarChar(1000)
  actualizadoPor   String?         @map("actualizado_por") @db.Char(36)
  actualizadoEn    DateTime        @default(now()) @updatedAt @map("actualizado_en") @db.DateTime(3)
  persona          PersonaCuidada  @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@map("ficha_medica")
}

model Alergia {
  id         String          @id @default(uuid()) @db.Char(36)
  personaId  String          @map("persona_id") @db.Char(36)
  sustancia  String          @db.VarChar(120)
  reaccion   String?         @db.Text
  severidad  Severidad
  persona    PersonaCuidada  @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@map("alergia")
}

model Padecimiento {
  id         String          @id @default(uuid()) @db.Char(36)
  personaId  String          @map("persona_id") @db.Char(36)
  nombre     String          @db.VarChar(120)
  desde      DateTime?       @db.Date
  notas      String?         @db.Text
  persona    PersonaCuidada  @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@map("padecimiento")
}

enum AccionConsentimiento {
  autorizar
  revocar
}

// Evidencia de consentimiento (RF-31). Solo inserción: no se actualiza ni se borra.
model Consentimiento {
  id           String               @id @default(uuid()) @db.Char(36)
  personaId    String               @map("persona_id") @db.Char(36)
  otorgadoPor  String               @map("otorgado_por") @db.Char(36)
  usuarioId    String               @map("usuario_id") @db.Char(36)
  accion       AccionConsentimiento
  rol          RolMiembro
  versionAviso String               @map("version_aviso") @db.VarChar(20)
  sesionId     String?              @map("sesion_id") @db.Char(36)
  creadoEn     DateTime             @default(now()) @map("creado_en") @db.DateTime(3)
  persona      PersonaCuidada       @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId, creadoEn])
  @@map("consentimiento")
}

// Convenio formal con una institución de salud (RF-38).
model Convenio {
  id            String                @id @default(uuid()) @db.Char(36)
  institucion   String                @db.VarChar(120)
  vigenteDesde  DateTime              @map("vigente_desde") @db.Date
  vigenteHasta  DateTime?             @map("vigente_hasta") @db.Date
  activo        Boolean               @default(true)
  profesionales ProfesionalConvenio[]

  @@map("convenio_institucional")
}

model ProfesionalConvenio {
  usuarioId  String   @id @map("usuario_id") @db.Char(36)
  convenioId String   @map("convenio_id") @db.Char(36)
  cedula     String   @db.VarChar(20)
  convenio   Convenio @relation(fields: [convenioId], references: [id], onDelete: Cascade)

  @@map("profesional_convenio")
}

// Accesos registrados a la ficha médica. Solo inserción.
model BitacoraAcceso {
  id        String         @id @default(uuid()) @db.Char(36)
  personaId String         @map("persona_id") @db.Char(36)
  usuarioId String         @map("usuario_id") @db.Char(36)
  sesionId  String?        @map("sesion_id") @db.Char(36)
  rol       RolMiembro
  accion    String         @db.VarChar(40)
  creadoEn  DateTime       @default(now()) @map("creado_en") @db.DateTime(3)
  persona   PersonaCuidada @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId, creadoEn])
  @@map("bitacora_acceso")
}

model Medicamento {
  id                  String         @id @default(dbgenerated("(uuid())")) @db.Char(36)
  personaId           String         @map("persona_id") @db.Char(36)
  nombre              String         @db.VarChar(120)
  presentacion        String?        @db.VarChar(60)
  dosis               Decimal        @db.Decimal(10, 2)
  unidad              String?        @db.VarChar(10)
  indicacion          String?        @db.Text
  frecuencia          String?        @db.VarChar(60)
  inicio              DateTime       @db.Date
  fin                 DateTime?      @db.Date
  existencias         Decimal?       @db.Decimal(10, 2)
  umbralResurtidoDias  Int            @default(5) @map("umbral_resurtido_dias") @db.SmallInt
  persona             PersonaCuidada @relation(fields: [personaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_medicamento_persona_id")

  recordatorios       Recordatorio[]

  @@index([personaId], map: "fk_medicamento_persona_id")
  @@map("medicamento")
}

enum TipoRecordatorio {
  medicamento
  cita
  tarea
  otro
}

model Recordatorio {
  id               String        @id @default(dbgenerated("(uuid())")) @db.Char(36)
  personaId        String        @map("persona_id") @db.Char(36)
  medicamentoId    String?       @map("medicamento_id") @db.Char(36)
  citaId           String?       @map("cita_id") @db.Char(36)
  tipo             TipoRecordatorio
  titulo           String        @db.VarChar(120)
  reglaRecurrencia String        @map("regla_recurrencia") @db.VarChar(255)
  margenOmisionMin Int           @default(30) @map("margen_omision_min") @db.SmallInt
  activo           Boolean       @default(true)
  persona          PersonaCuidada @relation(fields: [personaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recordatorio_persona_id")
  medicamento      Medicamento?   @relation(fields: [medicamentoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recordatorio_medicamento_id")

  @@index([medicamentoId], map: "fk_recordatorio_medicamento_id")
  @@index([citaId], map: "fk_recordatorio_cita_id")
  @@index([personaId, activo], map: "ix_recordatorio_persona_activo")
  @@map("recordatorio")
}
