generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoCuidado {
  edad_avanzada
  discapacidad
  enfermedad_cronica
  recuperacion
  menor_necesidades_especiales
  otro
}

enum TipoSanguineo {
  A_POS       @map("A+")
  A_NEG       @map("A-")
  B_POS       @map("B+")
  B_NEG       @map("B-")
  AB_POS      @map("AB+")
  AB_NEG      @map("AB-")
  O_POS       @map("O+")
  O_NEG       @map("O-")
  desconocido
}

enum Severidad {
  leve
  moderada
  grave
}

enum RolMiembro {
  titular
  administrador
  cocuidador
  solo_lectura
  temporal
}

enum EstadoMiembro {
  invitado
  activo
  revocado
  vencido
}

model PersonaCuidada {
  id               String        @id @default(uuid()) @db.Char(36)
  titularUsuarioId String?       @map("titular_usuario_id") @db.Char(36)
  nombre           String        @db.VarChar(120)
  fechaNacimiento  DateTime      @map("fecha_nacimiento") @db.Date
  telefono         String?       @db.VarChar(20)
  tipoCuidado      TipoCuidado   @map("tipo_cuidado")
  fotoUrl          String?       @map("foto_url") @db.VarChar(500)
  creadoPor        String?       @map("creado_por") @db.Char(36)
  creadoEn         DateTime      @default(now()) @map("creado_en") @db.DateTime(3)
  miembros         MiembroRed[]
  ficha            FichaMedica?

  @@map("persona_cuidada")
}

model MiembroRed {
  id          String          @id @default(uuid()) @db.Char(36)
  personaId   String          @map("persona_id") @db.Char(36)
  usuarioId   String          @map("usuario_id") @db.Char(36)
  rol         RolMiembro
  relacion    String?         @db.VarChar(40)
  estado      EstadoMiembro   @default(invitado)
  venceEn     DateTime?       @map("vence_en") @db.DateTime(3)
  invitadoPor String?         @map("invitado_por") @db.Char(36)
  persona     PersonaCuidada  @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, usuarioId])
  @@map("miembro_red")
}

model FichaMedica {
  personaId      String          @id @map("persona_id") @db.Char(36)
  tipoSanguineo  TipoSanguineo   @map("tipo_sanguineo")
  observaciones  String?         @db.VarChar(1000)
  actualizadoEn  DateTime        @updatedAt @map("actualizado_en") @db.DateTime(3)
  persona        PersonaCuidada  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  alergias       Alergia[]
  padecimientos  Padecimiento[]

  @@map("ficha_medica")
}

model Alergia {
  id         String       @id @default(uuid()) @db.Char(36)
  personaId  String       @map("persona_id") @db.Char(36)
  nombre     String       @db.VarChar(120)
  severidad  Severidad
  ficha      FichaMedica  @relation(fields: [personaId], references: [personaId], onDelete: Cascade)

  @@map("alergia")
}

model Padecimiento {
  id         String       @id @default(uuid()) @db.Char(36)
  personaId  String       @map("persona_id") @db.Char(36)
  nombre     String       @db.VarChar(120)
  notas      String?      @db.VarChar(500)
  ficha      FichaMedica  @relation(fields: [personaId], references: [personaId], onDelete: Cascade)

  @@map("padecimiento")
}
